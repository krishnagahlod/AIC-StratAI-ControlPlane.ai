# Required. Get one at https://aistudio.google.com/apikey — the free tier is sufficient.
# Note: changing this needs a backend restart. Settings are cached and the model client is
# built at import time, so an edit here has no effect on a running process.
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model for monitored application traffic, and the cheaper tier used for
# LLM-as-judge evaluation and the Executive Narrator.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite

# Free-tier Gemini quota is per model, per project, per day, so an exhausted model is a
# routine condition rather than an outage. Every call walks this ladder in order before
# giving up. Comma-separated; leave as-is unless you have a reason to change it.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-flash-lite

DATABASE_URL=sqlite:///./controlplane.db

# Optional. Enables the /api/demo endpoints, which re-open recent Human Review Queue items
# with a 10-minute SLA so a demo or recording can be retaken without the queue emptying
# itself. Leave unset (or 0) for normal use.
DEMO_MODE=0
