GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./controlplane.db

# Optional. Enables /api/demo endpoints, which re-open recent Human Review Queue
# items with a 10-minute SLA so a demo recording can be retaken without the queue
# emptying itself. Leave unset (or 0) for normal use.
DEMO_MODE=0
